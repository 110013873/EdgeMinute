# 密纪 EdgeMinute — environment variables (copy to .env and adjust).
# All values below are DEFAULTS; uncomment only what you need to override.
#
# NOTE: this file is loaded verbatim by systemd's EnvironmentFile, which does
# NOT support inline (trailing) "#" comments — the whole line after "=" becomes
# the value. Keep every comment on its own line, and never append a comment to
# a KEY=value line.

# ---- Inference device ----
# set to "cpu" if no GPU is available
# FUNASR_DEVICE=cuda

# ---- Web server ----
# EDGEMINUTE_HOST=0.0.0.0
# EDGEMINUTE_PORT=8899

# ---- LLM (Q&A panel, summary, agenda import) ----
# OpenAI-compatible endpoint (e.g. a local llama.cpp / vLLM server).
# LLM_BASE_URL=http://127.0.0.1:8080

# LLM_MODEL=Qwen3-30B-A3B-Instruct

# bearer token, if the endpoint requires one
# LLM_API_KEY=

# request timeout in seconds
# LLM_TIMEOUT=120

# max transcript chars injected into the chat system prompt
# CHAT_MAX_CONTEXT_CHARS=24000

# ---- Storage ----
# HISTORY_DB_PATH=data/meetings.db
# AUDIO_DIR=data/audio

# per uploaded audio file cap, in bytes (500 MB)
# AUDIO_MAX_BYTES=524288000

# per meeting JSON (text) payload cap, in bytes (10 MB)
# HISTORY_PAYLOAD_MAX_BYTES=10485760

# ---- Hotwords ----
# SeACo hotword bias strength (>1 pushes hotwords harder)
# HOTWORD_CLAS_SCALE=1.0

# ---- Voiceprint (speaker auto-identification) ----
# master switch: 0/false/empty -> off
# SV_ENABLED=1

# SV_MODEL_ID=iic/speech_campplus_sv_zh-cn_16k-common
# VOICEPRINT_DB_PATH=data/voiceprints.db
# VOICEPRINT_EMBEDDING_DIM=192

# min cosine similarity to auto-fill a speaker
# VOICEPRINT_MATCH_THRESHOLD=0.65

# longest N segments per cluster for the representative embedding
# VOICEPRINT_MAX_SEGMENTS=3

# segments shorter than this (seconds) are ignored
# VOICEPRINT_MIN_SEG_SECONDS=0.5

# per uploaded enrollment sample cap, in bytes (20 MB)
# VOICEPRINT_SAMPLE_MAX_BYTES=20971520
